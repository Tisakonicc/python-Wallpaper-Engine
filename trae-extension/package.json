{
  "name": "background-wallpaper-engine",
  "displayName": "Background-Wallpaper-Engine",
  "description": "Give your IDE a pulse: Steam Wallpaper Engine videos, scenes and web wallpapers play as your background with their own soundtrack, one-click readability tools and shareable .pkg packs. 100% local, no telemetry.",
  "publisher": "tisakonicc",
  "author": "Tisako",
  "version": "0.4.17",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tisakonicc/python-Wallpaper-Engine.git"
  },
  "homepage": "https://github.com/Tisakonicc/python-Wallpaper-Engine#readme",
  "bugs": {
    "url": "https://github.com/Tisakonicc/python-Wallpaper-Engine/issues"
  },
  "keywords": [
    "wallpaper",
    "wallpaper engine",
    "background",
    "steam",
    "video background",
    "scene.pkg",
    "mpkg",
    "animated wallpaper",
    "壁纸",
    "动态壁纸",
    "背景",
    "音乐"
  ],
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "webwallgl": "^3.0.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "backgroundWallpaperEngine.panel",
        "title": "打开壁纸面板",
        "category": "Background-Wallpaper-Engine"
      },
      {
        "command": "backgroundWallpaperEngine.choose",
        "title": "选择壁纸（快速列表）",
        "category": "Background-Wallpaper-Engine"
      },
      {
        "command": "backgroundWallpaperEngine.import",
        "title": "导入本地视频 / 图片 / 场景包…",
        "category": "Background-Wallpaper-Engine"
      },
      {
        "command": "backgroundWallpaperEngine.export",
        "title": "导出场景包为 scene.pkg（分享用）",
        "category": "Background-Wallpaper-Engine"
      },
      {
        "command": "backgroundWallpaperEngine.toggle",
        "title": "开关背景",
        "category": "Background-Wallpaper-Engine"
      },
      {
        "command": "backgroundWallpaperEngine.reapply",
        "title": "重新注入背景层",
        "category": "Background-Wallpaper-Engine"
      },
      {
        "command": "backgroundWallpaperEngine.remove",
        "title": "移除背景并还原 IDE",
        "category": "Background-Wallpaper-Engine"
      }
    ],
    "configuration": {
      "title": "Background-Wallpaper-Engine",
      "properties": {
        "backgroundWallpaperEngine.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "显示壁纸。关闭时立即隐藏，但保留注入；用“移除背景并还原 IDE”来彻底撤销注入。"
        },
        "backgroundWallpaperEngine.wallpaperId": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "当前壁纸的工坊 ID。通过“选择壁纸...”设置。"
        },
        "backgroundWallpaperEngine.steamRoot": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Steam 安装目录。留空则自动探测（注册表、常见路径、`libraryfolders.vdf`）。"
        },
        "backgroundWallpaperEngine.opacity": {
          "type": "number",
          "default": 0.45,
          "minimum": 0,
          "maximum": 1,
          "scope": "application",
          "description": "壁纸图层的不透明度。"
        },
        "backgroundWallpaperEngine.scrim": {
          "type": "number",
          "default": 0.45,
          "minimum": 0,
          "maximum": 1,
          "scope": "application",
          "description": "壁纸与 UI 之间的压暗层。越高文字越清晰，且不会因画面变亮而失效。"
        },
        "backgroundWallpaperEngine.autoContrast": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "根据壁纸亮度自动调整压暗（浅色主题则提亮）与轻微模糊，保证代码与文字清晰。默认关闭，需要时在面板「外观」里打开；开启后 `backgroundWallpaperEngine.scrim` 不再生效。"
        },
        "backgroundWallpaperEngine.surfaceOpacity": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "scope": "application",
          "markdownDescription": "侧栏、聊天面板、底部面板的底衬强度：0 = 完全透明（纯壁纸），1 = 完全遮住壁纸。文字压在亮画面上看不清时调高。"
        },
        "backgroundWallpaperEngine.textContrast": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "文字增强：把前景文字推向纯白（深色主题）/ 纯黑（浅色主题），并给字形加同色系阴影，让文字在亮壁纸上更清晰。默认关闭，需要时在面板「外观」里打开。只改前景色与阴影，不动语法高亮的 token 配色。"
        },
        "backgroundWallpaperEngine.blur": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 40,
          "scope": "application",
          "description": "壁纸模糊半径（像素）。"
        },
        "backgroundWallpaperEngine.saturate": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "scope": "application",
          "description": "壁纸饱和度。0 为灰度，1 为原始。"
        },
        "backgroundWallpaperEngine.fit": {
          "type": "string",
          "default": "cover",
          "enum": [
            "cover",
            "contain",
            "fill"
          ],
          "enumDescriptions": [
            "铺满窗口，裁掉多余部分。",
            "完整显示壁纸，比例不符时留边。",
            "拉伸铺满，忽略比例。"
          ],
          "scope": "application",
          "description": "壁纸相对窗口的缩放方式。"
        },
        "backgroundWallpaperEngine.fps": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 144,
          "scope": "application",
          "description": "场景 / 网页壁纸的渲染帧率（1–144）。视频壁纸由浏览器按原生帧率播放，不受此项影响。"
        },
        "backgroundWallpaperEngine.muted": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "静音壁纸自带的背景音乐。关闭（默认）时播放带音轨的视频 / 场景壁纸的声音。"
        },
        "backgroundWallpaperEngine.volume": {
          "type": "number",
          "default": 0.6,
          "minimum": 0,
          "maximum": 1,
          "scope": "application",
          "description": "壁纸背景音乐音量（0–1）。"
        },
        "backgroundWallpaperEngine.pauseOnBlur": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "窗口最小化时暂停播放，恢复显示后继续。切换窗口、点击 IDE 浮窗不再暂停。"
        },
        "backgroundWallpaperEngine.musicTrack": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "场景 / 网页壁纸自带多首音乐时选中的曲目值（对应 project.json 里 music 下拉框的 value）。留空表示沿用壁纸默认曲目。在面板「播放」页的「背景音乐」下拉框里切换。"
        },
        "backgroundWallpaperEngine.slideshow": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "开启壁纸轮播：按固定间隔在壁纸库中自动切换。"
        },
        "backgroundWallpaperEngine.slideshowInterval": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 120,
          "scope": "application",
          "description": "壁纸轮播间隔（分钟），1–120。"
        }
      }
    }
  }
}
